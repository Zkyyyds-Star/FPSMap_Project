# Public source allowlist. Local resources and generated output stay on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/resources.manifest.json
!/开始游戏.cmd
!/打开编辑器.cmd

!/scripts/
/scripts/*
!/scripts/build_unreal.ps1
!/scripts/package_unreal.ps1
!/scripts/check_resources.ps1
!/scripts/update_resource_manifest.ps1
!/scripts/verify_runtime.ps1
!/scripts/launchers/
!/scripts/maintenance/
/scripts/launchers/**
!/scripts/launchers/**/
!/scripts/launchers/**/*.ps1
!/scripts/launchers/**/*.cmd
/scripts/maintenance/**
!/scripts/maintenance/**/
!/scripts/maintenance/**/*.ps1

!/unreal/
/unreal/*
!/unreal/HeliosOutpost.uproject
!/unreal/Source/
!/unreal/Config/
/unreal/Source/**
!/unreal/Source/**/
!/unreal/Source/**/*.h
!/unreal/Source/**/*.cpp
!/unreal/Source/**/*.cs
!/unreal/Source/**/*.inl
/unreal/Config/**
!/unreal/Config/**/
!/unreal/Config/**/*.ini

# Keep temporary/secret files ignored even inside allowed directories.
**/__pycache__/
**/.venv/
**/.capture_runtime/
*.py[cod]
*.log
*.tmp
*.bak
*.user
*.suo
*.sln
*.VC.db
*.VC.opendb
.env
.env.*
*.pem
*.key
