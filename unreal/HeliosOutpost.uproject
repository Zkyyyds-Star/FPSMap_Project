{
  "FileVersion": 3,
  "EngineAssociation": "5.8",
  "Category": "Games",
  "Description": "Helios Outpost first-person environment and runtime control project.",
  "Modules": [
    {
      "Name": "HeliosOutpost",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "AdditionalDependencies": [
        "Engine",
        "TP_FirstPerson"
      ]
    },
    {
      "Name": "HeliosEnemyEditor",
      "Type": "Editor",
      "LoadingPhase": "Default"
    },
    {
      "Name": "TP_FirstPerson",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "AdditionalDependencies": [
        "Engine"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "ProceduralMeshComponent",
      "Enabled": true
    },
    {
      "Name": "PropertyBindingUtils",
      "Enabled": true
    },
    {
      "Name": "PythonScriptPlugin",
      "Enabled": true,
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "EditorScriptingUtilities",
      "Enabled": true,
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "StateTree",
      "Enabled": true
    },
    {
      "Name": "GameplayStateTree",
      "Enabled": true
    },
    {
      "Name": "IKRig",
      "Enabled": true
    },
    {
      "Name": "AndroidFileServer",
      "Enabled": false
    },
    {
      "Name": "Niagara",
      "Enabled": true
    }
  ]
}
