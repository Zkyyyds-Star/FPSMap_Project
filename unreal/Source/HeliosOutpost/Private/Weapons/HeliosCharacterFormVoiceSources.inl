static void Initialize(const TCHAR* Character,FName Variant,UHeliosSSXVoiceComponent* Voice,bool Spatial)
{
    if(!Voice)return;TMap<FName,USoundBase*> Cues;TArray<USoundBase*> Pool;
    for(const auto& S:Sources)if(FString(S.Character)==Character&&Variant==FName(S.Variant))
        if(auto* Sound=LoadObject<USoundBase>(nullptr,S.Path))
        {if(FName(S.Cue)==TEXT("Kill"))Pool.AddUnique(Sound);else if(!Cues.Contains(S.Cue))Cues.Add(S.Cue,Sound);}
    Voice->Stop();Voice->InitializeSources(Spatial,Cues,Pool);
    UE_LOG(LogTemp,Display,TEXT("CHARACTER_FORM_VOICE character=%s variant=%s kill_sources=%d cues=%d spatial=%d"),Character,*Variant.ToString(),Pool.Num(),Cues.Num(),Spatial);
}
